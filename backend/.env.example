/**
 * Environment Configuration Template
 * Copy this to .env and fill in your actual credentials
 *
 * Get your credentials from:
 * - Africa's Talking: https://africastalking.com/
 * - Storacha (IPFS): https://web3.storage
 */

# Africa's Talking API Configuration
# These are required for SMS functionality
AFRICAS_TALKING_API_KEY=atsk_ea7425fc39b6ed876bcf13c750e55294c6666b60a0222bbb5b192692327c1a1d6eca566e
AFRICAS_TALKING_USERNAME=sandbox

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:8080

# IPFS/Storacha Configuration
# Get from https://web3.storage
W3UP_EMAIL=your_email@example.com
W3UP_SPACE_DID=your_space_did_here

# Encryption Configuration
# Generate a strong 32+ character key for production
ENCRYPTION_KEY=your_32_character_encryption_key_here_change_this_in_production
